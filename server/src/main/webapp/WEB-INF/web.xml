<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="4.0">
  <listener><listener-class>ua.edu.nupp.kpp.server.web.DatabaseDriver</listener-class></listener>
  <servlet>
    <servlet-name>authors</servlet-name>
    <servlet-class>ua.edu.nupp.kpp.server.web.AuthorServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>reviewers</servlet-name>
    <servlet-class>ua.edu.nupp.kpp.server.web.ReviewerServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>documents</servlet-name>
    <servlet-class>ua.edu.nupp.kpp.server.web.DocumentServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>requests</servlet-name>
    <servlet-class>ua.edu.nupp.kpp.server.web.ApprovalRequestServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>authors</servlet-name>
    <url-pattern>/authors</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>reviewers</servlet-name>
    <url-pattern>/reviewers</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>documents</servlet-name>
    <url-pattern>/documents</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>requests</servlet-name>
    <url-pattern>/requests</url-pattern>
  </servlet-mapping>
</web-app>
